# Config for bonscompte-backup.sh / bonscompte-restore.sh.
# Copy to backup.env (git-ignored) next to the scripts, or point
# BONSCOMPTE_BACKUP_CONF at a file like this.
#
# BACKUP_INSTANCE and BORG_REPOS are required; the rest override script
# defaults. Only the production host should point at the production repos.

# Names the database being backed up; archives are bonscompte-<instance>-<ts>.
BACKUP_INSTANCE="prod"
BORG_REPOS=(
  "lan-host:bonscompte-borg"
  "user@offsite-host:bonscompte-borg"
)

#DB_PATH="/path/to/BonsCompte/backend/data/bonscompte.db"
#LOCAL_SNAP_DIR="$HOME/backups/bonscompte"
#LOCAL_KEEP=14
#PRUNE_OPTS=(--keep-daily 14 --keep-weekly 8 --keep-monthly 24)
# Repos are borg repokey with an empty passphrase (matches the immich setup:
# no prompt, key lives in the repo). Set this if you later add a passphrase
# with `borg key change-passphrase`.
#BORG_PASSPHRASE=""
